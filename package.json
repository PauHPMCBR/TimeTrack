{
  "name": "your-time-record-app",
  "private": true,
  "workspaces": [
    "shared",
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w @registre-jornada/backend\" \"npm run dev -w @registre-jornada/frontend\"",
    "build": "npm run build --workspaces",
    "lint": "npm run lint -w @registre-jornada/backend -w @registre-jornada/frontend",
    "test": "npm run test --workspaces",
    "test:run": "npm run test:run --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {}
}
