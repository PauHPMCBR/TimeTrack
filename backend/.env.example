# Backend environment. Copy to backend/.env and fill in real values.
# Never commit backend/.env.

# Required
MONGODB_URI=mongodb://alumne:<password>@localhost:27018/myapp?authSource=myapp
# 32+ random characters. Generate: openssl rand -base64 48
JWT_SECRET=change-me-at-least-32-characters-long
# Frontend origin allowed by the CORS middleware (httpOnly cookie auth).
FRONTEND_URL=http://localhost:3000

# Optional — runtime files (profile pictures). Defaults to ./backend/data.
# DATA_DIR=/absolute/path/to/data

# Optional — login lockout (defaults shown).
# BLOCK_MINUTES=10
# MAX_FAILED_LOGIN_ATTEMPTS=5

# Optional — uploads: per-file cap and per-user storage quota in bytes.
# FILE_MAX_BYTES=5242880
# FILES_STORAGE_QUOTA_BYTES=10485760

# Optional — set to "true" when running behind a reverse proxy so rate
# limiting uses X-Forwarded-For.
# TRUST_PROXY=false

# Email sending (Brevo SMTP relay — see deploy-docs/08-email.md).
# Leave SMTP_HOST unset to disable email (dev/tests).
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=<smtp-login>
# SMTP_PASS=<smtp-key>
# EMAIL_FROM=no-reply@your-domain.example
# COMPANY_NAME=TimeTrack360
# COMPANY_LANGUAGE=ca   # "ca" | "en" | "es" — language of outgoing emails
# EMAIL_LOGO_URL=https://.../brand/icon.png   # logo shown in email headers

# Optional — guards the manual trigger endpoints
# (POST /api/admin/indexes/sync, POST /api/admin/inconsistencies/notify)
# via the x-cron-secret header; admin JWTs are also accepted.
# CRON_SECRET=change-me-strong-cron-secret
