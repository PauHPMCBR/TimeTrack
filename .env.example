# Copy to .env and fill in real values. Never commit .env.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me-strong-root-password
MONGO_APP_USER=alumne
MONGO_APP_PASSWORD=change-me-strong-app-password

# Set to 1 to seed demo groups/reasons + demo accounts. All demo accounts
# share the password hashed in DEMO_PASSWORD_HASH (bcrypt). Generate with:
#   cd backend && node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 12))"
SEED_DEMO=0
DEMO_PASSWORD_HASH=

# 32+ random characters. Generate: openssl rand -base64 48
JWT_SECRET=change-me-at-least-32-characters-long

# Absolute path where the backend stores runtime files (profile pictures, ...).
# In production each company mounts its own host directory here; in dev the
# backend defaults to ./data if this is unset.
DATA_DIR=

# Email sending (Brevo SMTP relay — see deploy-docs/08-email.md).
# Leave SMTP_HOST unset to disable email (dev/tests).
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=<smtp-login>
# SMTP_PASS=<smtp-key>
# EMAIL_FROM=no-reply@your-domain.example
# COMPANY_NAME=TimeTrack360
# COMPANY_LANGUAGE=ca   # "ca" | "en" | "es" — official language for emails

# Daily inconsistency-reminder email. The scheduler runs automatically; whether
# reminders are sent is the company's "inconsistencyReminderEnabled" setting
# (admin panel, default ON), stored in the DB. CRON_SECRET guards the manual
# trigger endpoint POST /api/admin/inconsistencies/notify (x-cron-secret header).
# CRON_SECRET=change-me-strong-cron-secret
