# Frontend environment. Copy to frontend/.env.local and fill in real values.
# Never commit frontend/.env.local.

# Backend origin the browser talks to (httpOnly cookie auth).
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Optional — per-deployment branding (inlined at build time, see
# frontend/lib/brand.ts). Leave unset to use the defaults.
# NEXT_PUBLIC_APP_NAME=TimeTrack360
# NEXT_PUBLIC_FILE_MAX_BYTES=5242880
